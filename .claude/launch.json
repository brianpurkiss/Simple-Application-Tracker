{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "job-tracker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "job-tracker-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist-demo",
        "--port",
        "4173",
        "--strictPort"
      ],
      "env": {
        "VITE_DEMO": "1"
      },
      "port": 4173
    }
  ]
}
